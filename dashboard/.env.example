# Common Dashboard — configuration
# Copy to .env if you want to override any of these. All values already have
# sane defaults baked into src/config.js, so `npm run dev` works without
# creating this file.

# API Gateway — used ONLY to read /health for the status indicators.
# The dashboard never calls component backends directly.
VITE_GATEWAY_URL=http://localhost:8080

# Existing/standalone frontends this shell links out to. Detect
# (Component 1) now has its own frontend, built in Step 6B.
VITE_COMPONENT1_FRONTEND_URL=http://localhost:5176
VITE_COMPONENT2_FRONTEND_URL=http://localhost:5174
VITE_COMPONENT3_FRONTEND_URL=http://localhost:3000
VITE_COMPONENT4_FRONTEND_URL=http://localhost:5175
