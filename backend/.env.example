# InfluxDB (as given) -- live daily price feed storage.
# The backend runs fine with these unset/unreachable during dev: every
# lookup falls back to the historical CSVs in data/. By default, live access
# is disabled until you explicitly enable it and start a local InfluxDB.
INFLUXDB_ENABLED=false
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your_influxdb_token_here
INFLUXDB_ORG=ewaste_org
INFLUXDB_BUCKET=metal_prices

# Optional: how long a fetched USD/LKR + USD/INR rate is cached before
# services/fx_service.py fetches live again. Default 6 hours if unset.
FX_CACHE_TTL_SECONDS=21600

# Which folder services/pretrained_models.py reads model artifacts from,
# relative to backend/ (an absolute path also works). Default "models" if
# unset, so leaving this out keeps the original behaviour.
#
#   models      the original artifacts (scaler refitted on the full series
#               at request time -- carries the training notebook's leakage)
#   models_v2   retrained by scripts/train_production_v2.py with the
#               leakage-free pipeline of scripts/evaluate_c4_v2.py, and
#               shipping scaler_<metal>.pkl so inference reuses the exact
#               scaler from training instead of refitting one
MODEL_DIR=models_v2

# Which local authority strategic disposition measures facility distances
# from, as named in data/local_authorities.json (43 towns seeded from the
# repo gazetteer). A /api/disposition request can override it per call with
# explicit latitude/longitude, or name a different authority. Defaults to
# "Colombo" if unset.
DEFAULT_LOCAL_AUTHORITY=Colombo
