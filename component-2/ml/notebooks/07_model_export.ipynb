 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 07 — Model Export\n",
    "**E-Waste Toxic Gas Detection System — ML Pipeline**\n",
    "\n",
    "**Purpose:** Export the final trained model artifacts to the backend. Verify inference works end-to-end. Generate a model information card.\n",
    "\n",
    "**Author:** Sanjula Madushanka | Final Year Research Y4S2"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import shutil\n",
    "import json\n",
    "import joblib\n",
    "import time\n",
    "import warnings\n",
    "from pathlib import Path\n",
    "from datetime import datetime\n",
    "from sklearn.metrics import accuracy_score, f1_score\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "MODEL_DIR   = Path('../models')\n",
    "BACKEND_DIR = Path('../../backend/ml_models')\n",
    "DATA_DIR    = Path('../datasets/processed/train_test_split')\n",
    "\n",
    "BACKEND_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "print('Export notebook ready ✅')\n",
    "print(f'Source:      {MODEL_DIR}')\n",
    "print(f'Destination: {BACKEND_DIR}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7.1 Load All Artifacts"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "rf_model = joblib.load(MODEL_DIR / 'random_forest_v1.pkl')\n",
    "scaler   = joblib.load(MODEL_DIR / 'scaler.pkl')\n",
    "le       = joblib.load(MODEL_DIR / 'label_encoder.pkl')\n",
    "\n",
    "print('=== MODEL ARTIFACTS ===')\n",
    "print(f'Random Forest:  {type(rf_model).__name__}')\n",
    "print(f'  n_estimators: {rf_model.n_estimators}')\n",
    "print(f'  max_depth:    {rf_model.max_depth}')\n",
    "print(f'  n_features:   {rf_model.n_features_in_}')\n",
    "print()\n",
    "print(f'Scaler:         {type(scaler).__name__}')\n",
    "print(f'  n_features:   {scaler.n_features_in_}')\n",
    "print()\n",
    "print(f'LabelEncoder:   {type(le).__name__}')\n",
    "print(f'  Classes ({len(le.classes_)}): {list(le.classes_)}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7.2 End-to-End Inference Test"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "FEATURE_NAMES = ['mq2_ppm', 'mq7_ppm', 'mq135_ppm', 'mq303_ppm', 'mq136_ppm',\n",
    "                 'temperature_c', 'humidity_pct']\n",
    "\n",
    "# Test samples — known gas profiles\n",
    "test_samples = [\n",
    "    {'name': 'Mercury scenario (CRT Monitor)',\n",
    "     'features': [8.5, 5.0, 6.2, 0.052, 0.21, 28.0, 65.0]},  # High MQ303\n",
    "    {'name': 'CO scenario (PCB burning)',\n",
    "     'features': [32.0, 85.0, 12.0, 0.005, 0.30, 29.5, 62.0]},  # High MQ7\n",
    "    {'name': 'Clean air (Safe)',\n",
    "     'features': [3.0, 2.0, 3.0, 0.001, 0.08, 27.0, 60.0]},  # All low\n",
    "    {'name': 'H2S scenario (Li-ion battery)',\n",
    "     'features': [10.0, 6.5, 9.0, 0.004, 3.8, 30.0, 68.0]},  # High MQ136\n",
    "    {'name': 'LPG scenario (Capacitor)',\n",
    "     'features': [210.0, 10.0, 8.5, 0.004, 0.20, 26.0, 58.0]},  # High MQ2\n",
    "]\n",
    "\n",
    "print('=== END-TO-END INFERENCE TEST ===')\n",
    "print(f'{\"Scenario\":<35} {\"Predicted\":>12} {\"Confidence\":>12} {\"Time(ms)\":>10}')\n",
    "print('-' * 75)\n",
    "\n",
    "for sample in test_samples:\n",
    "    features = np.array([sample['features']])\n",
    "    \n",
    "    t0 = time.perf_counter()\n",
    "    # Step 1: Scale\n",
    "    features_scaled = scaler.transform(features)\n",
    "    # Step 2: Predict\n",
    "    pred_idx    = rf_model.predict(features_scaled)[0]\n",
    "    proba       = rf_model.predict_proba(features_scaled)[0]\n",
    "    confidence  = proba.max()\n",
    "    gas_class   = le.inverse_transform([pred_idx])[0]\n",
    "    t1 = time.perf_counter()\n",
    "    ms = (t1 - t0) * 1000\n",
    "    \n",
    "    print(f'{sample[\"name\"]:<35} {gas_class:>12} {confidence*100:>10.1f}% {ms:>9.2f}ms')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7.3 Compute Final Test Metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "X_test = pd.read_csv(DATA_DIR / 'X_test.csv').values\n",
    "y_test = pd.read_csv(DATA_DIR / 'y_test.csv').values.ravel()\n",
    "\n",
    "X_test_scaled = scaler.transform(X_test)\n",
    "y_pred = rf_model.predict(X_test_scaled)\n",
    "\n",
    "final_acc = accuracy_score(y_test, y_pred)\n",
    "final_f1  = f1_score(y_test, y_pred, average='weighted', zero_division=0)\n",
    "\n",
    "print(f'Final test accuracy:   {final_acc*100:.2f}%')\n",
    "print(f'Final F1 (weighted):   {final_f1*100:.2f}%')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7.4 Generate Model Information Card (JSON)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "model_card = {\n",
    "    'model_name':        'EWaste Toxic Gas Classifier',\n",
    "    'model_version':     'rf_v1',\n",
    "    'algorithm':         'Random Forest',\n",
    "    'trained_date':      datetime.now().strftime('%Y-%m-%d'),\n",
    "    'author':            'Sanjula Madushanka',\n",
    "    'research_project':  'E-Waste Toxic Gas Detection System (Y4S2)',\n",
    "    'hyperparameters': {\n",
    "        'n_estimators':      rf_model.n_estimators,\n",
    "        'max_depth':         str(rf_model.max_depth),\n",
    "        'max_features':      str(rf_model.max_features),\n",
    "        'min_samples_split': rf_model.min_samples_split,\n",
    "        'min_samples_leaf':  rf_model.min_samples_leaf,\n",
    "        'class_weight':      str(rf_model.class_weight),\n",
    "    },\n",
    "    'features': FEATURE_NAMES,\n",
    "    'n_features': len(FEATURE_NAMES),\n",
    "    'classes':    list(le.classes_),\n",
    "    'n_classes':  len(le.classes_),\n",
    "    'performance': {\n",
    "        'test_accuracy_pct':  round(final_acc * 100, 2),\n",
    "        'test_f1_weighted':   round(final_f1 * 100, 2),\n",
    "    },\n",
    "    'artifacts': {\n",
    "        'model':         'random_forest_v1.pkl',\n",
    "        'scaler':        'scaler.pkl',\n",
    "        'label_encoder': 'label_encoder.pkl',\n",
    "    },\n",
    "    'inference_note': 'Always apply scaler.transform() BEFORE calling model.predict()',\n",
    "}\n",
    "\n",
    "card_path = MODEL_DIR / 'model_card.json'\n",
    "with open(card_path, 'w') as f:\n",
    "    json.dump(model_card, f, indent=2)\n",
    "\n",
    "print('=== MODEL CARD ===')\n",
    "print(json.dumps(model_card, indent=2))\n",
    "print(f'\\n✅ Saved to {card_path}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7.5 Copy Artifacts to Backend"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "ARTIFACTS = [\n",
    "    MODEL_DIR / 'random_forest_v1.pkl',\n",
    "    MODEL_DIR / 'scaler.pkl',\n",
    "    MODEL_DIR / 'label_encoder.pkl',\n",
    "    MODEL_DIR / 'model_card.json',\n",
    "]\n",
    "\n",
    "print('=== COPYING ARTIFACTS TO BACKEND ===')\n",
    "for src in ARTIFACTS:\n",
    "    if src.exists():\n",
    "        dst = BACKEND_DIR / src.name\n",
    "        shutil.copy2(src, dst)\n",
    "        print(f'  ✅ {src.name} → {dst}')\n",
    "    else:\n",
    "        print(f'  ⚠ {src.name} NOT FOUND — run previous notebooks first')\n",
    "\n",
    "print()\n",
    "print('✅ All artifacts ready for FastAPI integration')\n",
    "print()\n",
    "print('=' * 60)\n",
    "print('ML PIPELINE COMPLETE!')\n",
    "print('=' * 60)\n",
    "print()\n",
    "print('Summary:')\n",
    "print('  Notebook 01: Data exploration & EDA')\n",
    "print('  Notebook 02: Preprocessing, SMOTE, scaling, splits')\n",
    "print('  Notebook 03: Feature importance, PCA analysis')\n",
    "print('  Notebook 04: Train RF + SVM + DT + NB')\n",
    "print('  Notebook 05: Full evaluation + confusion matrices + comparison table')\n",
    "print('  Notebook 06: Hyperparameter tuning (GridSearchCV)')\n",
    "print('  Notebook 07: Export to backend + model card')\n",
    "print()\n",
    "print('Next: Build the FastAPI backend (Step 3)')"
   ]
  }
 ],
