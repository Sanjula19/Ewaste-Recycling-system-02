# ---------------------------------------------------------------
# R26-IT-015 Component 4 — Predictive Economic Valuation &
# Strategic Disposition
# ---------------------------------------------------------------

# --- Python / backend ---
backend/venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Node / frontend ---
frontend/node_modules/
frontend/dist/

# --- Secrets & local config -------------------------------------
# .env.example files ARE tracked (they are templates with no real
# credentials). Real .env files hold InfluxDB tokens and must not be.
.env
.env.local
.env.*.local

# --- Runtime caches (regenerated automatically) -----------------
backend/.fx_cache.json
# Last successful exchange rate, written at runtime so a restart does
# not lose it. Machine state, not source.
backend/data/fx_last.json

# --- Editors / OS -----------------------------------------------
.vscode/
.idea/
Thumbs.db
Desktop.ini
desktop.ini
.DS_Store

# --- Arduino build output ---------------------------------------
Mayashi-IOT-handoff/**/build/

# --- Walk-forward model/decision caches (regenerated, ~69 MB) ----
# scripts/evaluate_c4_v2.py writes a per-retrain model and per-decision
# cache here purely so a crashed 6-hour run resumes instead of restarting.
# They are derived from data/v3/ + the script and carry no information the
# tracked results do not. Delete them and the next run rebuilds them.
#
# results_v3/ IS tracked -- its tables, figures, run_meta.json and
# decisions_raw.csv are what the paper cites. Nothing below excludes it.
backend/models_walkforward/
backend/models_walkforward_v3/
