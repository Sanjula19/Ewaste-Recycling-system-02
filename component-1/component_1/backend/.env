# ==================================================
# Component 1 — Shehan — AI Waste Assessment
# Backend environment configuration
# Copy this file to .env and fill in your local values.
# ==================================================

# Backend service port (assigned: 8001)
BACKEND_PORT=8001

# Raspberry Pi serial port connected to Arduino UNO (load cell)
SERIAL_PORT=/dev/ttyACM0
BAUD_RATE=9600

# ESP32-CAM image capture URL  (update to your camera's local IP)
CAMERA_URL=http://10.156.150.180/capture

# FastAPI backend URL — update HOST to the machine running this backend
BACKEND_HOST=http://localhost:8001
GENERAL_BACKEND_URL=http://localhost:8001/waste/predict
EWASTE_BACKEND_URL=http://localhost:8001/ewaste/analyze
