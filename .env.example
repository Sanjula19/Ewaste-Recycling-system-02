# Root Docker Compose configuration
# ---------------------------------------------------------------------------
# Copy to .env if you want to override any of these. All values already have
# sane defaults baked into docker-compose.yml, so `docker compose up --build`
# works without creating this file.
#
# Component-specific secrets (MQTT credentials, JWT keys, InfluxDB tokens,
# etc.) are NOT here — they stay in each component's own
# component-N/backend/.env, loaded per-service via `env_file:` in
# docker-compose.yml. This file only controls gateway routing and container
# wiring.

# API Gateway
GATEWAY_PORT=8080
PROXY_TIMEOUT=30
HEALTH_TIMEOUT=5
CORS_ORIGINS=*

# Inside Docker, services talk to each other by SERVICE NAME, never
# localhost. These match the service names in docker-compose.yml.
COMPONENT1_URL=http://component1:8001
COMPONENT2_URL=http://component2:8002
COMPONENT3_URL=http://component3:8003
COMPONENT4_URL=http://component4:8004
