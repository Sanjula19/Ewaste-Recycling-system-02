            },
            "description": "Glass doesn't combust -- expect a NEGATIVE energy_recovery_kwh. This is correct, not a bug.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"waste_type\": \"Contaminated Glass\",\n  \"weight_kg\": 15\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Classified as inert heat sink\", () => body.thermal_classification === \"inert_heat_sink\");",
                  "pm.test(\"Energy recovery is negative (costs energy, doesn't yield any)\", () =>",
                  "    body.energy_recovery_kwh < 0);",
                  "pm.test(\"Gross energy is zero (glass doesn't combust)\", () => body.gross_energy_kwh === 0);",
                  "pm.test(\"Wasted energy is positive\", () => body.wasted_energy_kwh > 0);",
                  ""
                ]
              }
            }
          ]
