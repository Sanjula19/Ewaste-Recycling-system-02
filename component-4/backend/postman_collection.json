    {
      "name": "Disposition (Strategic Disposition & Residual Pyrolysis Tracker)",
      "item": [
        {
          "name": "Disposition - PVC Plastic",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/disposition/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "disposition"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"waste_type\": \"PVC Plastic\",\n  \"weight_kg\": 42\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Classified as combustible\", () => body.thermal_classification === \"combustible\");",
                  "pm.test(\"Energy recovery is positive\", () => body.energy_recovery_kwh > 0);",
                  "pm.test(\"Route is Pyrolysis Processing\", () => body.disposition_route === \"Pyrolysis Processing\");",
                  "pm.test(\"Nearest facility present\", () => body.nearest_treatment_facility !== null);",
                  "pm.test(\"Revenue in both USD and LKR\", () => {",
                  "    pm.expect(body.estimated_revenue_usd).to.be.a(\"number\");",
                  "    pm.expect(body.estimated_revenue_lkr).to.be.a(\"number\");",
                  "});",
                  ""
                ]
              }
            }
          ]
        },
