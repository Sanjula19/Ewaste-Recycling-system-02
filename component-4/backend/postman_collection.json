              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Exactly the 6 in-scope metals, no gold/silver\", () => {",
                  "    pm.expect(body.metals.sort()).to.eql([\"aluminium\",\"copper\",\"lead\",\"nickel\",\"steel\",\"zinc\"]);",
                  "});",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "Forecast - Copper",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/forecast/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "forecast"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metal\": \"copper\",\n  \"weight_kg\": 15\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Recommendation is SELL NOW or HOLD\", () =>",
                  "    [\"SELL NOW\", \"HOLD\"].includes(body.recommendation));",
                  "pm.test(\"operator_action matches recommendation\", () => {",
                  "    if (body.recommendation === \"HOLD\") pm.expect(body.operator_action).to.eql(\"CRUSH_AND_COMPRESS\");",
                  "    if (body.recommendation === \"SELL NOW\") pm.expect(body.operator_action).to.eql(\"ROUTE_TO_MARKET_SALE\");",
                  "});",
                  "pm.test(\"Has 90 forecast points\", () => body.forecast_90d.length === 90);",
                  "pm.test(\"Has both USD and LKR prices\", () => {",
                  "    pm.expect(body.current_price).to.be.a(\"number\");",
                  "    pm.expect(body.current_price_lkr).to.be.a(\"number\");",
                  "});",
                  "pm.test(\"fx.source is live, cached, or fallback\", () =>",
                  "    [\"live\", \"cached\", \"fallback\"].includes(body.fx.source));",
                  "pm.test(\"MAPE and RMSE are numbers\", () => {",
                  "    pm.expect(body.mape).to.be.a(\"number\");",
                  "    pm.expect(body.rmse).to.be.a(\"number\");",
                  "});",
                  ""
                ]
              }
            }
          ]
        },
