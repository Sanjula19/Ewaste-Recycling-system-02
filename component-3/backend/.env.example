# Component 3 — CURRENT backend (toxic-gas clone, not the real Smart Process
# Optimization service — see integration/contracts/component3-contract.md).
# Local configuration template. Copy to .env and fill in real values. .env
# is intentionally untracked and NOT required for `docker compose build/up`
# to work (see docker-compose.yml) — without it, the container falls back
# to the defaults already present in app/config.py.

DATABASE_URL=sqlite+aiosqlite:///./component3_ewaste_gas.db

# HiveMQ Cloud (or your own MQTT broker) — required for live ESP32 data.
MQTT_BROKER=your-broker-host.example.com
MQTT_PORT=8883
MQTT_TOPIC=ewaste/esp32/sensors
MQTT_USER=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password

JWT_SECRET_KEY=change-me-to-a-different-random-secret
DEFAULT_API_KEY=change-me-esp32-device-key
