# ====================================================
# API Gateway — Environment Configuration
# Copy this file to .env and adjust as needed.
# ====================================================

# Gateway port
GATEWAY_PORT=8080

# Component backend URLs
COMPONENT1_URL=http://localhost:8001
COMPONENT2_URL=http://localhost:8002
COMPONENT3_URL=http://localhost:8003
COMPONENT4_URL=http://localhost:8004

# Proxy request timeout in seconds
PROXY_TIMEOUT=30

# Service health-check timeout in seconds  
HEALTH_TIMEOUT=5

# CORS — comma-separated origins allowed to call the gateway
# Use * to allow all origins during development
CORS_ORIGINS=*
